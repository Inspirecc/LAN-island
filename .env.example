# LAN ISLAND 本地环境变量示例
# 复制为 .env.local 使用(此文件不要提交到 Git)

# ===== 后台密码(必填,不填后台整体禁用)=====
ADMIN_PASSWORD=lanisland2026

# ===== 线上模式:让后台直接提交到 GitHub(本地开发可不填)=====
# 在 https://github.com/settings/tokens 生成 Fine-grained token,
# 仓库权限选 Contents: Read and write
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# GITHUB_REPO=Inspirecc/LAN-island

# ===== 评论系统 giscus(可选)=====
# 在 https://giscus.app/zh-CN 生成后填入
# NEXT_PUBLIC_GISCUS_REPO=
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=
